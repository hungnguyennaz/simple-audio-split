#include <windows.h>
#include <commctrl.h>
#ifndef IDC_STATIC
#define IDC_STATIC -1
#endif

#define IDI_APP 101
#define IDI_APP_OFF 102
#define IDD_MAIN 201

#define IDC_DEVICES 1001
#define IDC_TEST 1002
#define IDC_ENABLED 1003
#define IDC_STARTUP 1004
#define IDC_STATUS 1005
#define IDC_HINT 1006
#define IDC_DELAY 1007
#define IDC_DELAY_APPLY 1008
#define IDC_DELAY_HINT 1009

#define IDM_EXIT 40003

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_APP     ICON "app.ico"
IDI_APP_OFF ICON "app_off.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

IDD_MAIN DIALOGEX 0, 0, 320, 242
STYLE DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "Simple Audio Split"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Tick every device that should play your PC's sound:", IDC_STATIC, 10, 9, 300, 9
    CONTROL         "", IDC_DEVICES, WC_LISTVIEW, LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 10, 21, 300, 100
    PUSHBUTTON      "&Play test sound", IDC_TEST, 10, 127, 72, 14
    LTEXT           "Plays a short chime on the selected device, so you can tell identical headsets apart.", IDC_HINT, 89, 126, 191, 18
    LTEXT           "Extra &delay (ms):", IDC_STATIC, 10, 154, 72, 12
    EDITTEXT        IDC_DELAY, 85, 151, 48, 14, ES_NUMBER | WS_TABSTOP
    PUSHBUTTON      "&Apply delay", IDC_DELAY_APPLY, 140, 151, 62, 14
    LTEXT           "", IDC_DELAY_HINT, 10, 171, 300, 18
    CONTROL         "", IDC_STATIC, "Static", SS_ETCHEDHORZ, 10, 192, 300, 1
    LTEXT           "", IDC_STATUS, 10, 199, 300, 9, SS_ENDELLIPSIS
    CONTROL         "&Mirroring on", IDC_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 213, 140, 10
    CONTROL         "Start with &Windows", IDC_STARTUP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 227, 140, 10
    PUSHBUTTON      "E&xit", IDM_EXIT, 206, 224, 50, 14
    DEFPUSHBUTTON   "Close", IDCANCEL, 260, 224, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Simple Audio Split"
            VALUE "FileVersion", "2.0.0"
            VALUE "InternalName", "SimpleAudioSplit"
            VALUE "OriginalFilename", "SimpleAudioSplit.exe"
            VALUE "ProductName", "Simple Audio Split"
            VALUE "ProductVersion", "2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
